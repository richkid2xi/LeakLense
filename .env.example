# LeakLens Monorepo Root Environment Configuration

# Web
VITE_API_URL=http://localhost:3001
VITE_USE_MOCK=true

# Database & Supabase (Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# API
PORT=3001
NODE_ENV=development

# Worker Queue (uses same Postgres via pg-boss)
# DATABASE_URL is reused

# Billing Stubs (Phase 3)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
PADDLE_API_KEY=
PAYSTACK_SECRET_KEY=

# Email Stub (Phase 3)
RESEND_API_KEY=
FROM_EMAIL=notifications@leaklens.com
