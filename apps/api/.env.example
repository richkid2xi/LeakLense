# LeakLens API Environment Configuration
PORT=3001
NODE_ENV=development

# Database connection (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing Stubs (Phase 3)
LEMON_SQUEEZY_API_KEY=
PADDLE_API_KEY=
PAYSTACK_SECRET_KEY=

# Email Stub (Phase 3)
RESEND_API_KEY=
FROM_EMAIL=notifications@leaklens.com
