{
  "name": "leaklens-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @leaklens/web dev",
    "dev:all": "pnpm --parallel --filter @leaklens/web --filter @leaklens/api --filter @leaklens/worker dev",
    "dev:api": "pnpm --filter @leaklens/api dev",
    "dev:worker": "pnpm --filter @leaklens/worker dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.0"
  }
}
